# ClausCheck — root .env (gitignored). Copy to ../.env and fill in.
# See docs/HLD.md section 1 for the full service/variable contract.

# --- Postgres (pgvector/pgvector:pg16, host port 5433) ---
POSTGRES_PASSWORD=

# --- paperless-ngx (host port 8010, mounted at /docs-ui behind Caddy) ---
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
# Filled in after bootstrap by `make up` / the setup script, via
# `drf_create_token` or POST /api/token/. Used by the api/worker to talk
# to paperless; never exposed to end users.
PAPERLESS_API_TOKEN=

# --- api/worker auth & crypto ---
JWT_SECRET=
# Fernet key (32 url-safe base64 bytes) used to encrypt llm_providers.api_key_enc.
FERNET_KEY=

# --- LLM providers (api/app/llm/) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- embeddings (sentence-transformers, worker) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- registro / solicitudes de acceso (api/app/routers/access_requests.py) ---
# open: POST /auth/register libre. approval|closed: 403, sólo por
# /solicitar-acceso + aprobación de superadmin en /admin/solicitudes.
REGISTRATION_MODE=approval

# --- correo saliente (api/app/mail.py) ---
# console: sólo loguea el mensaje (por defecto, dev). smtp: envía por
# aiosmtplib (puerto 465 → TLS implícito, 587 → STARTTLS).
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ClausCheck
# Recibe el aviso de "nueva solicitud de acceso".
ADMIN_NOTIFY_EMAIL=

# Base pública de la web, usada para armar enlaces en los correos
# (invitación, aprobación de solicitudes).
APP_BASE_URL=http://localhost:8080

# --- Fase B: Cloudflare Tunnel (compose profile `edge`) ---
CF_TUNNEL_TOKEN=
PUBLIC_URL=http://localhost:8080   # URL pública (p.ej. https://mvp.clauscheck.info); usada por paperless para CSRF
